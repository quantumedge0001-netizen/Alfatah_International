# Public URL of the deployed app — used to build links (e.g. password reset
# emails) so they always point here instead of whatever host the request came from.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase project settings — get these from Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used server-side for admin actions (creating Admin/User accounts) and
# by lib/supabase/service.ts for webhook/automation writes. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta (Facebook) Lead Ads webhook — Settings > Webhooks in your Meta App,
# plus a Page access token with the leads_retrieval permission.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-page-access-token
META_VERIFY_TOKEN=choose-any-random-string-and-reuse-it-when-registering-the-webhook
