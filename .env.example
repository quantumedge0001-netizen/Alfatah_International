# Supabase project settings — get these from Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used server-side for admin actions (creating Admin/User accounts). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
